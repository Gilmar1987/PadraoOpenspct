{
  "config": {
    "default": true,
    // Prosa em pt-BR quebra linhas livremente; comprimento não indica erro.
    "MD013": false,
    // Arquivos de agente/skill começam com frontmatter seguido de instruções, sem título H1.
    "MD041": false,
    // Tabelas com placeholders vazios não seguem um estilo de coluna único.
    "MD060": false
  },
  "ignores": [
    "node_modules/**",
    // Conteúdo vendorizado: skills e comandos gerados pelo OpenSpec CLI e a skill externa de code review.
    // Corrigir o estilo deles divergiria da origem a cada regeneração.
    ".claude/skills/openspec-*/**",
    ".claude/commands/opsx/**",
    ".claude/skills/requesting-code-review/**",
    // Registro gerado pelo /opsx:verify: uma entrada por execução, com títulos de data que podem se repetir.
    "openspec/changes/**/verification.md",
    // Registro gravado pelo /opsx:apply (revisão de código): mesmo formato, uma entrada datada por revisão.
    "openspec/changes/**/review.md",
    "openspec/changes/**/.inputs/**"
  ]
}
